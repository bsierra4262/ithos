# ITHOS Gestor — variables de entorno del despliegue.
# Copiá este archivo a  .env  y completá los valores. NO subas .env a git ni lo compartas.
#   cp .env.example .env   &&   nano .env

# ── Acceso al Gestor (superadmin) — SOLO INTELLIHELP ──────────────────────────
# Con estos datos se entra al panel superadmin (https://tu-dominio/). El cliente NUNCA entra acá.
ITHOS_ADMIN_USER=intellihelp
# Poné una clave FUERTE y larga (podés generarla con:  openssl rand -base64 24 )
ITHOS_ADMIN_TOKEN=CAMBIA-ESTO-por-una-clave-fuerte

# ── Cifrado EN REPOSO de los secretos del cliente (AES-256-GCM) ──────────────
# Clave MAESTRA con la que se cifran las claves de IA, tokens de GLPI, contraseñas de la DB de
# fichajes, token de MercadoPago, contraseña de agente, etc. en clientes.json. DEBE vivir acá (en
# el .env, aparte de los datos) y NUNCA en el repo ni en un backup junto con los datos: si te roban
# el clientes.json sin esta clave, no pueden descifrar nada. Generala con:  openssl rand -base64 32
# Si la cambiás, los datos ya cifrados dejan de poder descifrarse: cambiala UNA vez y guardala.
ITHOS_MASTER_KEY=CAMBIA-ESTO-por-openssl-rand-base64-32

# ── Datos persistentes (dejar así en Docker) ─────────────────────────────────
ITHOS_DATA=/data

# Nota: las claves de IA (Gemini/Groq/Cerebras) y de MercadoPago van POR CLIENTE en el panel,
# no acá (y se guardan CIFRADAS). Este archivo solo tiene el acceso del Gestor, la clave maestra
# de cifrado y rutas de datos.
